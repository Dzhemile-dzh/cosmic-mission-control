#!/usr/bin/env php
<?php

declare(strict_types=1);

use Cosmic\Console\Application;
use Cosmic\Service\JsonFileFleetStorage;
use Cosmic\Service\MissionControl;

require dirname(__DIR__).'/vendor/autoload.php';

$application = new Application(
    new JsonFileFleetStorage(dirname(__DIR__).'/resources/fleet.json'),
    new MissionControl(),
);

exit($application->run($argv));
